{
  "name": "evicap",
  "description": "Capture and preserve web evidence for investigations.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": "Civil Digital <info@civildigital.co.uk>",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && vitest run --config vitest.e2e.config.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "hash-wasm": "4.12.0",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.3.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "fake-indexeddb": "6.2.6",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  }
}
